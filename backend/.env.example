PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://admin:change-me-postgres@localhost:5432/cnc_research?schema=public&connection_limit=5&connect_timeout=15&pool_timeout=30"
TEST_DATABASE_URL="postgresql://admin:change-me-postgres@localhost:5432/cnc_research_test?schema=public"
CLIENT_URL=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=change-me-jwt-secret
ADMIN_PASSWORD=change-me-admin

# Explicit fixture engine for local development only.
ENGINE_RUNNER=fake
WORKER_POLL_MS=1000
ENGINE_TIMEOUT_MS=30000
WORKER_LEASE_MS=120000
WORKER_HEARTBEAT_MS=40000
WORKER_SHUTDOWN_MS=30000

# Operations read scope: ADMIN reads all; other users require explicit database UUID grants.
OPERATIONS_FACTORY_ACCESS={}
# Operations planner transport; never falls back to a fixture or implicit URL.
AI_SERVICE_URL=http://127.0.0.1:8001
AI_TRANSPORT_ALLOWANCE_MS=2000
# Dedicated Decision Case worker. Heartbeat must not exceed the lease duration.
DECISION_CASE_POLL_MS=1000
DECISION_CASE_LEASE_MS=30000
DECISION_CASE_HEARTBEAT_MS=10000
# Optional validator executable override (otherwise backend/.venv-operations is used).
# OPERATIONS_PYTHON=C:/path/to/python.exe
# Seed must explicitly target a development/demo database; no DATABASE_URL fallback.
# OPERATIONS_DEMO_DATABASE_URL=postgresql://admin:password@127.0.0.1:5433/cnc_research?schema=public
