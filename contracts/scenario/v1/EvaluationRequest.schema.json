{
  "$defs": {
    "AssignmentStatus": {
      "enum": [
        "PROPOSED",
        "COMMITTED",
        "RUNNING",
        "COMPLETED",
        "CANCELLED"
      ],
      "title": "AssignmentStatus",
      "type": "string"
    },
    "AssignmentType": {
      "enum": [
        "PRODUCTION",
        "MAINTENANCE",
        "BLOCKED_TIME"
      ],
      "title": "AssignmentType",
      "type": "string"
    },
    "Baseline": {
      "additionalProperties": false,
      "properties": {
        "publication": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicationIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "snapshot": {
          "$ref": "#/$defs/FactorySnapshot"
        },
        "snapshot_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Snapshot Hash",
          "type": "string"
        }
      },
      "required": [
        "snapshot",
        "snapshot_hash"
      ],
      "title": "Baseline",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "remaining_ms": {
          "maximum": 300000,
          "minimum": 1,
          "title": "Remaining Ms",
          "type": "integer"
        }
      },
      "required": [
        "remaining_ms"
      ],
      "title": "Budget",
      "type": "object"
    },
    "DeferMaintenance": {
      "additionalProperties": false,
      "properties": {
        "earliest_start_at": {
          "format": "date-time",
          "title": "Earliest Start At",
          "type": "string"
        },
        "maintenance_request_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Maintenance Request Id",
          "type": "string"
        },
        "type": {
          "const": "DEFER_MAINTENANCE",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "maintenance_request_id",
        "earliest_start_at"
      ],
      "title": "DeferMaintenance",
      "type": "object"
    },
    "DiscreteRULDistribution": {
      "additionalProperties": false,
      "properties": {
        "model_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Model Version",
          "type": "string"
        },
        "probability_mass": {
          "items": {
            "maximum": 1.0,
            "minimum": 0.0,
            "type": "number"
          },
          "minItems": 2,
          "title": "Probability Mass",
          "type": "array"
        },
        "support_minutes": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "minItems": 2,
          "title": "Support Minutes",
          "type": "array"
        },
        "survival_beyond_horizon": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Survival Beyond Horizon",
          "type": "number"
        }
      },
      "required": [
        "support_minutes",
        "probability_mass",
        "survival_beyond_horizon",
        "model_version"
      ],
      "title": "DiscreteRULDistribution",
      "type": "object"
    },
    "FactorySnapshot": {
      "additionalProperties": false,
      "properties": {
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "current_schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/Schedule"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "factory_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Factory Id",
          "type": "string"
        },
        "health_snapshots": {
          "items": {
            "$ref": "#/$defs/HealthSnapshot"
          },
          "title": "Health Snapshots",
          "type": "array"
        },
        "jobs": {
          "items": {
            "$ref": "#/$defs/ProductionJob"
          },
          "title": "Jobs",
          "type": "array"
        },
        "machines": {
          "items": {
            "$ref": "#/$defs/Machine"
          },
          "minItems": 1,
          "title": "Machines",
          "type": "array"
        },
        "maintenance_requests": {
          "items": {
            "$ref": "#/$defs/MaintenanceRequest"
          },
          "title": "Maintenance Requests",
          "type": "array"
        },
        "planning_window": {
          "$ref": "#/$defs/TimeWindow"
        },
        "schema_version": {
          "const": "3.0",
          "default": "3.0",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "technicians": {
          "items": {
            "$ref": "#/$defs/Technician"
          },
          "title": "Technicians",
          "type": "array"
        }
      },
      "required": [
        "snapshot_id",
        "factory_id",
        "captured_at",
        "planning_window",
        "machines"
      ],
      "title": "FactorySnapshot",
      "type": "object"
    },
    "HealthSnapshot": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "failure_probability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Failure Probability",
          "type": "number"
        },
        "failure_probability_horizon_minutes": {
          "minimum": 1,
          "title": "Failure Probability Horizon Minutes",
          "type": "integer"
        },
        "health_index": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Health Index",
          "type": "number"
        },
        "health_snapshot_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Health Snapshot Id",
          "type": "string"
        },
        "machine_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Machine Id",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "observed_wear_um": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Wear Um"
        },
        "rul_distribution": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiscreteRULDistribution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_model_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Source Model Version",
          "type": "string"
        }
      },
      "required": [
        "health_snapshot_id",
        "machine_id",
        "observed_at",
        "health_index",
        "failure_probability_horizon_minutes",
        "failure_probability",
        "confidence",
        "source_model_version"
      ],
      "title": "HealthSnapshot",
      "type": "object"
    },
    "Identity": {
      "additionalProperties": false,
      "properties": {
        "factory_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Factory Id",
          "type": "string"
        },
        "frozen_input_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Frozen Input Hash",
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Run Id",
          "type": "string"
        },
        "workspace_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "factory_id",
        "workspace_id",
        "run_id",
        "frozen_input_hash"
      ],
      "title": "Identity",
      "type": "object"
    },
    "Machine": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "$ref": "#/$defs/MachineCapability"
          },
          "minItems": 1,
          "title": "Capabilities",
          "type": "array"
        },
        "display_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "machine_family": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Machine Family",
          "type": "string"
        },
        "machine_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Machine Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/MachineStatus"
        }
      },
      "required": [
        "machine_id",
        "display_name",
        "machine_family",
        "status",
        "capabilities"
      ],
      "title": "Machine",
      "type": "object"
    },
    "MachineCapability": {
      "additionalProperties": false,
      "properties": {
        "damage_factor": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Damage Factor",
          "type": "number"
        },
        "load_factor": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Load Factor",
          "type": "number"
        },
        "nominal_processing_minutes": {
          "minimum": 1,
          "title": "Nominal Processing Minutes",
          "type": "integer"
        },
        "operation_type": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Operation Type",
          "type": "string"
        }
      },
      "required": [
        "operation_type",
        "nominal_processing_minutes"
      ],
      "title": "MachineCapability",
      "type": "object"
    },
    "MachineOption": {
      "additionalProperties": false,
      "properties": {
        "expected_damage": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Damage"
        },
        "load_factor": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Load Factor",
          "type": "number"
        },
        "machine_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Machine Id",
          "type": "string"
        },
        "processing_minutes": {
          "minimum": 1,
          "title": "Processing Minutes",
          "type": "integer"
        }
      },
      "required": [
        "machine_id",
        "processing_minutes"
      ],
      "title": "MachineOption",
      "type": "object"
    },
    "MachineStatus": {
      "enum": [
        "IDLE",
        "RUNNING",
        "WARNING",
        "MAINTENANCE",
        "FAILED",
        "UNAVAILABLE"
      ],
      "title": "MachineStatus",
      "type": "string"
    },
    "MaintenanceDuration": {
      "additionalProperties": false,
      "properties": {
        "expected_duration_minutes": {
          "maximum": 43200,
          "minimum": 1,
          "title": "Expected Duration Minutes",
          "type": "integer"
        },
        "maintenance_request_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Maintenance Request Id",
          "type": "string"
        },
        "type": {
          "const": "MAINTENANCE_DURATION",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "maintenance_request_id",
        "expected_duration_minutes"
      ],
      "title": "MaintenanceDuration",
      "type": "object"
    },
    "MaintenancePriority": {
      "enum": [
        "LOW",
        "NORMAL",
        "HIGH",
        "CRITICAL"
      ],
      "title": "MaintenancePriority",
      "type": "string"
    },
    "MaintenanceRequest": {
      "additionalProperties": false,
      "properties": {
        "action_type": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Action Type",
          "type": "string"
        },
        "earliest_start_at": {
          "format": "date-time",
          "title": "Earliest Start At",
          "type": "string"
        },
        "expected_duration_minutes": {
          "minimum": 1,
          "title": "Expected Duration Minutes",
          "type": "integer"
        },
        "latest_start_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latest Start At"
        },
        "machine_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Machine Id",
          "type": "string"
        },
        "maintenance_request_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Maintenance Request Id",
          "type": "string"
        },
        "maintenance_type": {
          "$ref": "#/$defs/MaintenanceType"
        },
        "mandatory": {
          "default": false,
          "title": "Mandatory",
          "type": "boolean"
        },
        "minimum_skill_level": {
          "default": 1,
          "maximum": 5,
          "minimum": 1,
          "title": "Minimum Skill Level",
          "type": "integer"
        },
        "priority": {
          "$ref": "#/$defs/MaintenancePriority"
        },
        "requested_at": {
          "format": "date-time",
          "title": "Requested At",
          "type": "string"
        },
        "required_skill_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Skill Ids",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/MaintenanceRequestStatus"
        }
      },
      "required": [
        "maintenance_request_id",
        "machine_id",
        "maintenance_type",
        "action_type",
        "priority",
        "status",
        "requested_at",
        "earliest_start_at",
        "expected_duration_minutes",
        "required_skill_ids"
      ],
      "title": "MaintenanceRequest",
      "type": "object"
    },
    "MaintenanceRequestStatus": {
      "enum": [
        "OPEN",
        "SCHEDULED",
        "IN_PROGRESS",
        "COMPLETED",
        "CANCELLED"
      ],
      "title": "MaintenanceRequestStatus",
      "type": "string"
    },
    "MaintenanceType": {
      "enum": [
        "PREVENTIVE",
        "CORRECTIVE"
      ],
      "title": "MaintenanceType",
      "type": "string"
    },
    "ObjectiveWeights": {
      "additionalProperties": false,
      "properties": {
        "maintenance": {
          "default": 1.0,
          "minimum": 0.0,
          "title": "Maintenance",
          "type": "number"
        },
        "production": {
          "default": 1.0,
          "minimum": 0.0,
          "title": "Production",
          "type": "number"
        },
        "reliability": {
          "default": 1.0,
          "minimum": 0.0,
          "title": "Reliability",
          "type": "number"
        },
        "schedule_stability": {
          "default": 0.25,
          "minimum": 0.0,
          "title": "Schedule Stability",
          "type": "number"
        },
        "workforce": {
          "default": 1.0,
          "minimum": 0.0,
          "title": "Workforce",
          "type": "number"
        }
      },
      "title": "ObjectiveWeights",
      "type": "object"
    },
    "Operation": {
      "additionalProperties": false,
      "properties": {
        "machine_options": {
          "items": {
            "$ref": "#/$defs/MachineOption"
          },
          "minItems": 1,
          "title": "Machine Options",
          "type": "array"
        },
        "operation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Operation Id",
          "type": "string"
        },
        "operation_type": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Operation Type",
          "type": "string"
        },
        "predecessor_operation_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Predecessor Operation Ids",
          "type": "array"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/OperationStatus",
          "default": "PENDING"
        }
      },
      "required": [
        "operation_id",
        "sequence",
        "operation_type",
        "machine_options"
      ],
      "title": "Operation",
      "type": "object"
    },
    "OperationStatus": {
      "enum": [
        "PENDING",
        "READY",
        "SCHEDULED",
        "RUNNING",
        "COMPLETED",
        "BLOCKED"
      ],
      "title": "OperationStatus",
      "type": "string"
    },
    "ProductionJob": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "due_at": {
          "format": "date-time",
          "title": "Due At",
          "type": "string"
        },
        "job_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Job Id",
          "type": "string"
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/Operation"
          },
          "minItems": 1,
          "title": "Operations",
          "type": "array"
        },
        "priority": {
          "default": 50,
          "maximum": 100,
          "minimum": 1,
          "title": "Priority",
          "type": "integer"
        },
        "release_at": {
          "format": "date-time",
          "title": "Release At",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "display_name",
        "release_at",
        "due_at",
        "operations"
      ],
      "title": "ProductionJob",
      "type": "object"
    },
    "PublicationIdentity": {
      "additionalProperties": false,
      "properties": {
        "plan_version": {
          "minimum": 1,
          "title": "Plan Version",
          "type": "integer"
        },
        "schedule_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Schedule Hash",
          "type": "string"
        },
        "schedule_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Schedule Id",
          "type": "string"
        },
        "schedule_revision": {
          "minimum": 1,
          "title": "Schedule Revision",
          "type": "integer"
        }
      },
      "required": [
        "schedule_id",
        "schedule_revision",
        "schedule_hash",
        "plan_version"
      ],
      "title": "PublicationIdentity",
      "type": "object"
    },
    "SamplingSpec": {
      "additionalProperties": false,
      "properties": {
        "base_seed": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Base Seed",
          "type": "integer"
        },
        "coupling": {
          "const": "COMMON_RANDOM_NUMBERS",
          "default": "COMMON_RANDOM_NUMBERS",
          "title": "Coupling",
          "type": "string"
        },
        "sample_count": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Sample Count",
          "type": "integer"
        },
        "version": {
          "const": "scenario-crn:1",
          "default": "scenario-crn:1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "base_seed",
        "sample_count"
      ],
      "title": "SamplingSpec",
      "type": "object"
    },
    "ScenarioPlanningConfig": {
      "additionalProperties": false,
      "properties": {
        "allowed_strategy_ids": {
          "items": {
            "enum": [
              "production-priority",
              "balanced",
              "reliability-priority"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Allowed Strategy Ids",
          "type": "array"
        },
        "base_seed": {
          "default": 0,
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Base Seed",
          "type": "integer"
        },
        "candidate_limit": {
          "default": 3,
          "maximum": 3,
          "minimum": 1,
          "title": "Candidate Limit",
          "type": "integer"
        },
        "horizon_minutes": {
          "maximum": 43200,
          "minimum": 1,
          "title": "Horizon Minutes",
          "type": "integer"
        },
        "objective_weights": {
          "$ref": "#/$defs/ObjectiveWeights"
        },
        "simulation_runs": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "title": "Simulation Runs",
          "type": "integer"
        },
        "solver_timeout_seconds": {
          "default": 30,
          "maximum": 30,
          "minimum": 1,
          "title": "Solver Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "horizon_minutes",
        "objective_weights",
        "allowed_strategy_ids"
      ],
