{
  "$defs": {
    "AssignmentStatus": {
      "enum": [
        "PROPOSED",
        "COMMITTED",
        "RUNNING",
        "COMPLETED",
        "CANCELLED"
      ],
      "title": "AssignmentStatus",
      "type": "string"
    },
    "AssignmentType": {
      "enum": [
        "PRODUCTION",
        "MAINTENANCE",
        "BLOCKED_TIME"
      ],
      "title": "AssignmentType",
      "type": "string"
    },
    "CandidateAvailability": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "FEASIBLE",
            "NO_FEASIBLE_PLAN",
            "TIMEOUT",
            "NOT_EVALUATED"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "strategy": {
          "title": "Strategy",
          "type": "string"
        }
      },
      "required": [
        "strategy",
        "outcome"
      ],
      "title": "CandidateAvailability",
      "type": "object"
    },
    "CandidatePlan": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "candidate_plan_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Candidate Plan Id",
          "type": "string"
        },
        "decision_case_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Decision Case Id",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "kpis": {
          "$ref": "#/$defs/PlanKPIs"
        },
        "plan_version": {
          "minimum": 1,
          "title": "Plan Version",
          "type": "integer"
        },
        "schedule": {
          "$ref": "#/$defs/Schedule"
        },
        "schema_version": {
          "const": "3.0",
          "default": "3.0",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_agent_run_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Source Agent Run Ids",
          "type": "array"
        },
        "source_engine_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Source Engine Id",
          "type": "string"
        },
        "source_engine_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Source Engine Version",
          "type": "string"
        },
        "strategy": {
          "$ref": "#/$defs/PlanStrategy"
        },
        "validation": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanValidation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "warnings": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "candidate_plan_id",
        "decision_case_id",
        "snapshot_id",
        "plan_version",
        "strategy",
        "source_engine_id",
        "source_engine_version",
        "generated_at",
        "schedule",
        "kpis"
      ],
      "title": "CandidatePlan",
      "type": "object"
    },
    "Comparison": {
      "additionalProperties": false,
      "properties": {
        "metric_registry_version": {
          "const": "scenario-metrics:1",
          "default": "scenario-metrics:1",
          "title": "Metric Registry Version",
          "type": "string"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/MetricComparison"
          },
          "title": "Metrics",
          "type": "array"
        },
        "model_assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Model Assumptions",
          "type": "array"
        },
        "score_comparison": {
          "const": "NOT_COMPARABLE_ACROSS_REFERENCES",
          "default": "NOT_COMPARABLE_ACROSS_REFERENCES",
          "title": "Score Comparison",
          "type": "string"
        }
      },
      "required": [
        "metrics",
        "model_assumptions"
      ],
      "title": "Comparison",
      "type": "object"
    },
    "ConstraintSeverity": {
      "enum": [
        "ERROR",
        "WARNING"
      ],
      "title": "ConstraintSeverity",
      "type": "string"
    },
    "ConstraintViolation": {
      "additionalProperties": false,
      "properties": {
        "constraint_code": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Constraint Code",
          "type": "string"
        },
        "entity_refs": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Entity Refs",
          "type": "array"
        },
        "message": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/ConstraintSeverity"
        },
        "time_window": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeWindow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "violation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Violation Id",
          "type": "string"
        }
      },
      "required": [
        "violation_id",
        "constraint_code",
        "severity",
        "message"
      ],
      "title": "ConstraintViolation",
      "type": "object"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Code",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "message": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "target_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Target Ids",
          "type": "array"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "DurationAxis": {
      "additionalProperties": false,
      "properties": {
        "maintenance_request_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Maintenance Request Id",
          "type": "string"
        },
        "type": {
          "const": "MAINTENANCE_DURATION",
          "title": "Type",
          "type": "string"
        },
        "values": {
          "items": {
            "maximum": 43200,
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 7,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "type",
        "maintenance_request_id",
        "values"
      ],
      "title": "DurationAxis",
      "type": "object"
    },
    "Evaluation": {
      "additionalProperties": false,
      "properties": {
        "candidate_availability": {
          "items": {
            "$ref": "#/$defs/CandidateAvailability"
          },
          "title": "Candidate Availability",
          "type": "array"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/CandidatePlan"
          },
          "maxItems": 3,
          "title": "Candidates",
          "type": "array"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "outcome": {
          "enum": [
            "FEASIBLE",
            "NO_FEASIBLE_PLAN",
            "TIMEOUT",
            "FAILED"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "partial": {
          "default": false,
          "title": "Partial",
          "type": "boolean"
        },
        "ranking": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ranking"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "selected_candidate_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Candidate Id"
        }
      },
      "required": [
        "outcome"
      ],
      "title": "Evaluation",
      "type": "object"
    },
    "Identity": {
      "additionalProperties": false,
      "properties": {
        "factory_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Factory Id",
          "type": "string"
        },
        "frozen_input_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Frozen Input Hash",
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Run Id",
          "type": "string"
        },
        "workspace_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "factory_id",
        "workspace_id",
        "run_id",
        "frozen_input_hash"
      ],
      "title": "Identity",
      "type": "object"
    },
    "MetricComparison": {
      "additionalProperties": false,
      "properties": {
        "absolute_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Absolute Delta"
        },
        "baseline": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Baseline"
        },
        "change": {
          "enum": [
            "IMPROVED_UNDER_MODEL",
            "WORSENED_UNDER_MODEL",
            "UNCHANGED",
            "UNAVAILABLE"
          ],
          "title": "Change",
          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "percent_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Percent Delta"
        },
        "preferred_direction": {
          "enum": [
            "LOWER",
            "HIGHER"
          ],
          "title": "Preferred Direction",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "scenario": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scenario"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "unit",
        "preferred_direction",
        "baseline",
        "scenario",
        "absolute_delta",
        "percent_delta",
        "reason",
        "change"
      ],
      "title": "MetricComparison",
      "type": "object"
    },
    "ObjectiveWeights": {
      "additionalProperties": false,
      "properties": {
        "maintenance": {
          "default": 1.0,
          "minimum": 0.0,
          "title": "Maintenance",
          "type": "number"
        },
        "production": {
          "default": 1.0,
          "minimum": 0.0,
          "title": "Production",
          "type": "number"
        },
        "reliability": {
          "default": 1.0,
          "minimum": 0.0,
          "title": "Reliability",
          "type": "number"
        },
        "schedule_stability": {
          "default": 0.25,
          "minimum": 0.0,
          "title": "Schedule Stability",
          "type": "number"
        },
        "workforce": {
          "default": 1.0,
          "minimum": 0.0,
          "title": "Workforce",
          "type": "number"
        }
      },
      "title": "ObjectiveWeights",
      "type": "object"
    },
    "PlanKPIs": {
      "additionalProperties": false,
      "properties": {
        "decision_latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Latency Ms"
        },
        "expected_emergency_downtime_minutes": {
          "minimum": 0.0,
          "title": "Expected Emergency Downtime Minutes",
          "type": "number"
        },
        "expected_failure_count": {
          "minimum": 0.0,
          "title": "Expected Failure Count",
          "type": "number"
        },
        "failure_probability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Failure Probability",
          "type": "number"
        },
        "maintenance_cost": {
          "minimum": 0.0,
          "title": "Maintenance Cost",
          "type": "number"
        },
        "makespan_minutes": {
          "minimum": 0.0,
          "title": "Makespan Minutes",
          "type": "number"
        },
        "maximum_tardiness_minutes": {
          "minimum": 0.0,
          "title": "Maximum Tardiness Minutes",
          "type": "number"
        },
        "on_time_completion_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "On Time Completion Rate",
          "type": "number"
        },
        "schedule_changes": {
          "minimum": 0,
          "title": "Schedule Changes",
          "type": "integer"
        },
        "technician_utilization": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Technician Utilization",
          "type": "number"
        },
        "total_tardiness_minutes": {
          "minimum": 0.0,
          "title": "Total Tardiness Minutes",
          "type": "number"
        }
      },
      "required": [
        "makespan_minutes",
        "total_tardiness_minutes",
        "maximum_tardiness_minutes",
        "on_time_completion_rate",
        "expected_failure_count",
        "failure_probability",
        "expected_emergency_downtime_minutes",
        "maintenance_cost",
        "technician_utilization",
        "schedule_changes"
      ],
      "title": "PlanKPIs",
      "type": "object"
    },
    "PlanStrategy": {
      "enum": [
        "CURRENT",
        "PRODUCTION_PRIORITY",
        "BALANCED",
        "RELIABILITY_PRIORITY",
        "MANUAL",
        "EXPERIMENTAL"
      ],
      "title": "PlanStrategy",
      "type": "string"
    },
    "PlanValidation": {
      "additionalProperties": false,
      "properties": {
        "candidate_plan_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Candidate Plan Id",
          "type": "string"
        },
        "schema_version": {
          "const": "3.0",
          "default": "3.0",
          "title": "Schema Version",
          "type": "string"
        },
        "simulation_runs": {
          "default": 0,
          "minimum": 0,
          "title": "Simulation Runs",
          "type": "integer"
        },
        "validated_at": {
          "format": "date-time",
          "title": "Validated At",
          "type": "string"
        },
        "validation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Validation Id",
          "type": "string"
        },
        "validator_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Validator Version",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/ValidationVerdict"
        },
        "violations": {
          "items": {
            "$ref": "#/$defs/ConstraintViolation"
          },
          "title": "Violations",
          "type": "array"
        },
        "warnings": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "validation_id",
        "candidate_plan_id",
        "validator_version",
        "verdict",
        "validated_at"
      ],
      "title": "PlanValidation",
      "type": "object"
    },
    "RankChangeInterval": {
      "additionalProperties": false,
      "properties": {
        "from_strategy": {
          "title": "From Strategy",
          "type": "string"
        },
        "interpretation": {
          "const": "SAMPLED_INTERVAL_NOT_EXACT_THRESHOLD",
          "default": "SAMPLED_INTERVAL_NOT_EXACT_THRESHOLD",
          "title": "Interpretation",
          "type": "string"
        },
        "lower_sample": {
          "title": "Lower Sample",
          "type": "number"
        },
        "to_strategy": {
          "title": "To Strategy",
          "type": "string"
        },
        "upper_sample": {
          "title": "Upper Sample",
          "type": "number"
        }
      },
      "required": [
        "lower_sample",
        "upper_sample",
        "from_strategy",
        "to_strategy"
      ],
      "title": "RankChangeInterval",
      "type": "object"
    },
    "Ranking": {
      "additionalProperties": false,
      "properties": {
        "constant_range_benefit": {
          "const": 1,
          "default": 1,
          "title": "Constant Range Benefit",
          "type": "integer"
        },
        "normalization_reference_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Normalization Reference Id",
          "type": "string"
        },
        "normalized_weights": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Normalized Weights",
          "type": "object"
        },
        "raw_weights": {
          "$ref": "#/$defs/ObjectiveWeights"
        },
        "reference_bounds": {
          "additionalProperties": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Reference Bounds",
          "type": "object"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/RankingRow"
          },
          "title": "Rows",
          "type": "array"
        },
        "tie_break": {
          "items": {
            "type": "string"
          },
          "title": "Tie Break",
          "type": "array"
        },
        "version": {
          "const": "objective-minmax:1",
          "default": "objective-minmax:1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "normalization_reference_id",
        "reference_bounds",
        "tie_break",
        "raw_weights",
        "normalized_weights",
        "rows"
      ],
      "title": "Ranking",
      "type": "object"
    },
    "RankingRow": {
      "additionalProperties": false,
      "properties": {
        "candidate_plan_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Candidate Plan Id",
          "type": "string"
        },
        "metric_benefits": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Metric Benefits",
          "type": "object"
        },
        "objective_benefits": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Objective Benefits",
          "type": "object"
        },
        "raw_kpis": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Raw Kpis",
          "type": "object"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "strategy": {
          "title": "Strategy",
          "type": "string"
        },
        "tied_with": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Tied With",
          "type": "array"
        },
        "weighted_contributions": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Weighted Contributions",
          "type": "object"
        }
      },
      "required": [
        "candidate_plan_id",
        "strategy",
        "score",
        "raw_kpis",
        "metric_benefits",
        "objective_benefits",
        "weighted_contributions",
        "tied_with"
      ],
      "title": "RankingRow",
      "type": "object"
    },
    "SamplingEvidence": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256-first53-uniform:1",
          "title": "Algorithm",
          "type": "string"
        },
        "base_seed": {
          "maximum": 2147483647,
          "minimum": 0,
